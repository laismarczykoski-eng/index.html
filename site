        // --- INTERACTABILITY & RAYCASTING TOOLTIPS ---
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();

        function setupRaycaster() {
            window.addEventListener('mousemove', (e) => {
                mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
                mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;

                raycaster.setFromCamera(mouse, camera);
                const intersects = raycaster.intersectObjects(scene.children, true);

                if (intersects.length > 0) {
                    let obj = intersects[0].object;
                    while (obj && !obj.userData.title && obj.parent) {
                        obj = obj.parent;
                    }
                    if (obj && obj.userData.title) {
                        showTooltip(e.clientX, e.clientY, obj.userData.title, obj.userData.desc);
                        return;
                    }
                }
                hideTooltip();
            });
        }

        function showTooltip(x, y, title, desc) {
            const el = document.getElementById('tooltip');
            document.getElementById('tooltip-title').children[0].innerText = title;
            document.getElementById('tooltip-desc').innerText = desc;
            el.style.left = `${x + 15}px`;
            el.style.top = `${y + 15}px`;
            el.classList.remove('hidden');
            el.classList.remove('opacity-0');
        }

        function hideTooltip() {
            const el = document.getElementById('tooltip');
            el.classList.add('opacity-0');
        }

        // --- CAMERA FOCUS HOTSPOTS (GSAP Smooth Transitions) ---
        function focusCamera(targetKey) {
            let targetPos, lookTarget;

            switch (targetKey) {
                case 'arduino':
                    targetPos = { x: -4, y: 5, z: 8 };
                    lookTarget = { x: -4, y: 0, z: 1 };
                    break;
                case 'pool':
                    targetPos = { x: 5, y: 6, z: 9 };
                    lookTarget = { x: 5, y: 1.5, z: 3 };
                    break;
                case 'panel':
                    targetPos = { x: 0, y: 6, z: 5 };
                    lookTarget = { x: 0, y: 2.5, z: -2 };
                    break;
                case 'overview':
                default:
                    targetPos = { x: 12, y: 14, z: 18 };
                    lookTarget = { x: 0, y: 2, z: 0 };
                    break;
            }

            gsap.to(camera.position, {
                x: targetPos.x,
                y: targetPos.y,
                z: targetPos.z,
                duration: 1.5,
                ease: 'power2.inOut'
            });

            gsap.to(controls.target, {
                x: lookTarget.x,
                y: lookTarget.y,
                z: lookTarget.z,
                duration: 1.5,
                ease: 'power2.inOut'
            });
        }

        // --- INFRARED / THERMAL VISION MODE ---
        function toggleThermalVision() {
            state.thermalMode = !state.thermalMode;
            const overlay = document.getElementById('thermal-overlay');
            const btn = document.getElementById('btn-thermal');

            if (state.thermalMode) {
                overlay.classList.add('thermal-tint-active', 'opacity-100');
                btn.classList.add('bg-amber-500', 'text-slate-950');
                scene.background = new THREE.Color(0x1a0000);
            } else {
                overlay.classList.remove('thermal-tint-active', 'opacity-100');
                btn.classList.remove('bg-amber-500', 'text-slate-950');
                scene.background = new THREE.Color(0x0a0f1d);
            }
        }

        // --- IR REMOTE CONTROL COMMAND SIMULATION ---
        function sendIRCommand(cmd) {
            // Pulse IR Sensor Mesh visual glow
            if (irSensorMesh) {
                gsap.to(irSensorMesh.material.color, { r: 1, g: 0.4, b: 0, duration: 0.1, yoyo: true, repeat: 3 });
            }

            if (cmd === 'HEAT_ON') {
                state.pumpActive = true;
                document.getElementById('toggle-pump').checked = true;
            } else if (cmd === 'HEAT_OFF') {
                state.pumpActive = false;
                document.getElementById('toggle-pump').checked = false;
            } else if (cmd === 'MODE_AUTO') {
                state.panelTilt = 30;
                document.getElementById('slider-panel-tilt').value = 30;
                if (solarPanelGroup && solarPanelGroup.head) {
                    solarPanelGroup.head.rotation.x = (30 * Math.PI) / 180;
                }
            }
        }

        // --- EVENT LISTENERS FOR CONTROLS ---
        function setupEventListeners() {
            // Sun Angle Slider
            document.getElementById('slider-sun-angle').addEventListener('input', (e) => {
                state.sunAngle = parseFloat(e.target.value);
                document.getElementById('val-sun-angle').innerText = `${state.sunAngle}°`;
                updateSunPosition();
            });

            // Sun Intensity Slider
            document.getElementById('slider-sun-intensity').addEventListener('input', (e) => {
                state.sunIntensity = parseFloat(e.target.value);
                document.getElementById('val-sun-intensity').innerText = `${state.sunIntensity} W/m²`;
                updateSunPosition();
            });

            // Panel Tilt Slider
            document.getElementById('slider-panel-tilt').addEventListener('input', (e) => {
                state.panelTilt = parseFloat(e.target.value);
                document.getElementById('val-panel-tilt').innerText = `${state.panelTilt}°`;
                if (solarPanelGroup && solarPanelGroup.head) {
                    solarPanelGroup.head.rotation.x = (state.panelTilt * Math.PI) / 180;
                }
            });

            // Pump Toggle
            document.getElementById('toggle-pump').addEventListener('change', (e) => {
                state.pumpActive = e.target.checked;
            });
        }

        // --- SIDEBAR TABS & TOGGLE ---
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('translate-x-full');
        }

        function switchTab(tabId) {
            ['sim', 't6', 't7', 't8', 't9'].forEach(t => {
                const btn = document.getElementById(`tab-btn-${t}`);
                const content = document.getElementById(`tab-content-${t}`);
                if (t === tabId) {
                    btn.className = "flex-1 py-2 rounded-lg transition text-blue-400 bg-slate-800 shadow font-bold";
                    content.classList.remove('hidden');
                } else {
                    btn.className = "flex-1 py-2 rounded-lg transition text-slate-400 hover:text-slate-200";
                    content.classList.add('hidden');
                }
            });
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        // --- MAIN RENDER LOOP ---
        function animate() {
            requestAnimationFrame(animate);

            controls.update();
            updatePhysics();
            updateSteamParticles();

            // Rotate Solar Panel slightly with tracker mode
            if (solarPanelGroup) {
                solarPanelGroup.rotation.y = Math.sin(state.time * 0.2) * 0.05;
            }

            renderer.render(scene, camera);
        }

        // --- INITIALIZATION ON WINDOW LOAD ---
        window.onload = function() {
            init3D();
            setupEventListeners();
            initChart();

            // Render KaTeX Math Expressions
            if (window.renderMathInElement) {
                renderMathInElement(document.body, {
                    delimiters: [
                        {left: '$$', right: '$$', display: true},
                        {left: '$', right: '$', display: false}
                    ]
                });
            }
        };
    </script>
</body>
</html>
