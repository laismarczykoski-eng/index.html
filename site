        // --- STEAM PARTICLES OVER WARM WATER ---
        function createSteamParticles() {
            const count = 40;
            const geo = new THREE.BufferGeometry();
            const pos = new Float32Array(count * 3);

            for (let i = 0; i < count; i++) {
                pos[i * 3] = (Math.random() - 0.5) * 3 + 5;
                pos[i * 3 + 1] = Math.random() * 2 + 2.8;
                pos[i * 3 + 2] = (Math.random() - 0.5) * 3 + 3;
            }

            geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
            const mat = new THREE.PointsMaterial({
                color: 0xffffff,
                size: 0.15,
                transparent: true,
                opacity: 0.25
            });

            steamParticles = new THREE.Points(geo, mat);
            scene.add(steamParticles);
        }

        function updateSteamParticles() {
            if (!steamParticles) return;
            const pos = steamParticles.geometry.attributes.position.array;
            const isWarm = state.waterTemp > 28;
            steamParticles.visible = isWarm;

            if (isWarm) {
                for (let i = 0; i < pos.length / 3; i++) {
                    pos[i * 3 + 1] += 0.015;
                    if (pos[i * 3 + 1] > 5) {
                        pos[i * 3 + 1] = 2.8;
                    }
                }
                steamParticles.geometry.attributes.position.needsUpdate = true;
            }
        }

        // --- PHYSICS & COMPUTATION ENGINE ---
        function updatePhysics() {
            state.time += 0.05;

            // 1. Calculate Solar Radiation & Angle Effect
            const sunRad = (state.sunAngle * Math.PI) / 180;
            const panelRad = (state.panelTilt * Math.PI) / 180;
            const angleOffset = Math.abs(sunRad - (Math.PI / 2 - panelRad));
            const effectiveIrradiance = state.sunIntensity * Math.max(0, Math.cos(angleOffset));

            // 2. Photovoltaic Generation (P = A * G * eff)
            const area = 0.15; // m2
            const efficiency = 0.18;
            state.solarPower = area * effectiveIrradiance * efficiency;
            state.solarVoltage = Math.min(5.1, 1.2 + (state.solarPower / 3.0));

            // 3. LDR Light Sensor Resistance (R = R_dark / Lux^gamma)
            const lux = effectiveIrradiance * 8.5;
            state.ldrResistance = Math.max(100, Math.round(500000 / (lux + 10)));
            document.getElementById('read-lux').innerText = `~${Math.round(lux)} Lux`;

            // 4. Pool Water Thermal Dynamics (Q = m * c * dT)
            if (state.pumpActive && effectiveIrradiance > 200) {
                const heatGain = (effectiveIrradiance * 0.0008) * state.heatingPower;
                state.waterTemp = Math.min(45.0, state.waterTemp + heatGain);
                state.accumulatedHeat += heatGain * 12.5;
            } else {
                // Cooling towards ambient (22°C)
                state.waterTemp = Math.max(22.0, state.waterTemp - 0.005);
            }

            // 5. Update UI Telemetry Reads
            const noise = (Math.random() - 0.5) * 0.06; // 12-bit DS18B20 noise
            const displayTemp = (state.waterTemp + noise).toFixed(1);

            document.getElementById('read-temp').innerText = `${displayTemp} °C`;
            document.getElementById('read-ldr').innerText = `${(state.ldrResistance / 1000).toFixed(2)} kΩ`;
            document.getElementById('read-volt').innerText = `${state.solarVoltage.toFixed(2)} V`;
            document.getElementById('read-power').innerText = `Potência: ${state.solarPower.toFixed(1)} W`;
            document.getElementById('read-heat').innerText = `${state.accumulatedHeat.toFixed(1)} kJ`;

            // LCD Emulation Lines
            document.getElementById('lcd-line-1').innerText = `T:${displayTemp}C SOL:${Math.round(effectiveIrradiance)}W`;
            document.getElementById('lcd-line-2').innerText = `V:${state.solarVoltage.toFixed(2)}V P:${state.solarPower.toFixed(1)}W`;

            // 6. Dynamic Water Color Transition (Blue -> Red Tint as Temp Rises)
            if (waterMaterial) {
                const tempRatio = Math.min(1, Math.max(0, (state.waterTemp - 22) / 20));
                poolWaterColor.setHSL(0.55 - tempRatio * 0.55, 0.9, 0.5);
                waterMaterial.color = poolWaterColor;
            }
        }

        // --- SUN POSITION ANIMATION ---
        function updateSunPosition() {
            const rad = (state.sunAngle * Math.PI) / 180;
            const radius = 18;
            const x = radius * Math.cos(rad);
            const y = radius * Math.sin(rad);

            sunLight.position.set(x, y, 5);
            sunMesh.position.set(x, y, 5);

            // Sun intensity factor
            const factor = state.sunIntensity / 1000;
            sunLight.intensity = Math.max(0.2, Math.sin(rad) * 3.5 * factor);
        }

